---
/**
 * The night sky, across the whole hero: the star field and the Milky Way.
 *
 * Stars used to be authored inside the two band SVGs — four in the orbit strip,
 * seven in the panorama — which put every one of them in the top eighth of the
 * page and left the largest stretch of sky, the field behind the copy, empty.
 * The bands are also two different coordinate systems, so matching their
 * densities to each other was guesswork. This is one sky over the whole section
 * instead, and the bands draw nothing of their own.
 *
 * GENERATED, NOT AUTHORED. Everything else in the scene is a hand-written table
 * of points, because every one of those points is a decision — where the river
 * bends, where the ridge peaks. A star field is the opposite: no individual star
 * matters and all the meaning is in the DISTRIBUTIONS, so the honest way to
 * write it is to state the rules and let a seeded generator draw the sample.
 * The seed is fixed, so the sky is identical on every build; change it and you
 * get a different sky with the same statistics.
 *
 * Three rules make it read as a sky rather than as scattered dots:
 *
 *   MAGNITUDE. Real skies are mostly faint stars with a few bright ones, and a
 *   bright star is both larger and more opaque. A field of uniform dots reads as
 *   noise; the same count with this distribution reads as depth.
 *
 *   THE GALAXY. A diagonal band carrying its own denser, fainter population —
 *   most of the Milky Way's stars are individually below the threshold, which is
 *   why it looks like cloud. The diffuse glow underneath is the part that is
 *   genuinely unresolved.
 *
 *   ALTITUDE. Density thins toward the horizon, which is what air does, and is
 *   also what the composition needs: the bottom of this box is where the peaks
 *   come up, and a dense field there fights the ridgeline.
 *
 * COORDINATES ARE PERCENTAGES, and the SVG has no viewBox. That combination is
 * the point: `cx`/`cy` resolve against the element, so the sky always spans the
 * hero whatever shape it is, while `r` stays in pixels — a star is the same size
 * on a phone as on a desktop. Give this a viewBox and a narrow window gets the
 * same picture scaled up, which on a phone means a handful of fat dots.
 *
 * It sits at `z-index: 0` and FIRST in the hero, so the orbit band — same layer,
 * later in the DOM — paints its track and craft over the sky rather than under
 * it. The panorama (z 1), the cliff (z 1) and the copy (z 2) all cover it.
 *
 * COST. Around 310 circles, which is ~30 kB of markup and 3.4 kB over the wire —
 * the elements are near-identical, so gzip takes almost all of it back. It is
 * still the largest single thing on the landing page after the panorama, and the
 * counts below are the dial: the galactic population is where the density is
 * doing real work, and the general field is where it can be cut cheapest.
 *
 * Paint, the galaxy's blur, and the phone thinning are in scene.css.
 */
import Celestial from "./Celestial.astro";

/** Twinkle clocks, defined in scene.css. Five, so no group visibly pulses together. */
const CLOCKS = ["a", "b", "c", "d", "e"] as const;

interface Star {
  /** Percent of the hero's width and height. */
  x: number;
  y: number;
  /** Radius in CSS pixels — deliberately not a percentage. */
  r: number;
  clock: (typeof CLOCKS)[number];
  /** Magnitude class suffix; "" is the middle of the three. */
  mag: "" | "faint" | "bright";
}

/**
 * mulberry32 — a small, well-distributed PRNG.
 *
 * `Math.random` would reshuffle the sky on every build, which makes a visual
 * diff meaningless and means a layout you liked cannot be got back. Seeded, the
 * generated markup is a pure function of this file.
 */
function mulberry32(seed: number): () => number {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(20260901);

/** Roughly normal, bounded to ±1. Four uniforms is plenty at this precision. */
const gauss = (): number => (rand() + rand() + rand() + rand() - 2) * 0.5;

const pick = <T,>(items: readonly T[]): T => items[Math.floor(rand() * items.length)]!;
const r1 = (n: number) => Math.round(n * 10) / 10;
const r3 = (n: number) => Math.round(n * 1000) / 1000;

/**
 * One star's magnitude, and the radius that goes with it.
 *
 * `pFaint`/`pMid` are the shares of the two lower classes; the remainder is
 * bright. The galactic band passes a higher `pFaint` because that is precisely
 * what distinguishes it — many more stars, almost none of them resolvable.
 */
function magnitude(pFaint: number, pMid: number): Pick<Star, "r" | "mag"> {
  const u = rand();
  if (u < pFaint) return { mag: "faint", r: r1(0.55 + rand() * 0.3) };
  if (u < pFaint + pMid) return { mag: "", r: r1(0.85 + rand() * 0.35) };
  return { mag: "bright", r: r1(1.25 + rand() * 0.45) };
}

/* The galactic equator, as a line across the box in percent: it enters at the
   left near the horizon and leaves through the top right, where the cliff cuts
   it off. That occlusion is wanted — a band that runs clean off the corner reads
   as a printed stripe, one that goes behind the rock reads as sky.

   One line, used three ways: it is where the galactic stars crowd, it is the
   spine the glow clumps are hung off, and it is the halo stroke in the markup
   below. Move it and all three follow. */
const WAY_LEFT = 88;
const WAY_RIGHT = 4;
const wayY = (x: number) => WAY_LEFT + ((WAY_RIGHT - WAY_LEFT) * x) / 100;

/** How far the sky reaches down the box before the panorama's peaks take over. */
const FLOOR = 84;

const stars: Star[] = [];

/* The general field. `** 1.25` biases the sample upward — density falls off
   toward the horizon rather than being flat. */
for (let i = 0; i < 130; i++) {
  const x = r1(rand() * 100);
  const y = r1(FLOOR * rand() ** 1.25);
  stars.push({ x, y, clock: pick(CLOCKS), ...magnitude(0.6, 0.32) });
}

/* The galactic population, gathered on the equator with a soft falloff. Stars
   that scatter off the top or below the floor are dropped rather than clamped —
   clamping would pile them up in a line along the edge.

   The count and the SPREAD are both load bearing. The glow alone came out
   looking like a searchlight swept across the hero — a smooth, clean streak,
   which is exactly what the Milky Way is not; it is the crowd of faint stars on
   the glow that reads as a galaxy, so this population is larger than the whole
   rest of the sky. And it has to be tight: at a wide scatter the extra stars
   just raise the density of the whole sky and no band appears at all. */
const way: Star[] = [];
for (let i = 0; i < 190; i++) {
  const x = r1(rand() * 100);
  const y = r1(wayY(x) + gauss() * 8);
  if (y < 1 || y > FLOOR) continue;
  way.push({ x, y, clock: pick(CLOCKS), ...magnitude(0.86, 0.12) });
}

/**
 * The glow, as a run of overlapping clumps rather than three clean strokes.
 *
 * A stroke of even weight down the whole diagonal is a beam. Real galactic light
 * is patchy — brighter where the star clouds are, dimmer where dust is in front
 * — and cutting the band into segments of varying length, offset and weight is
 * what produces that unevenness once the whole group is blurred together.
 *
 * `side` keeps every clump off the centre line, alternating above and below it.
 * The lane left down the middle is the Great Rift, and it is a GAP rather than a
 * darker stroke because the sky behind it is a gradient that no flat fill would
 * match at both ends.
 */
interface Clump {
  x1: number;
  y1: number;
  x2: number;
  y2: number;
  width: number;
  opacity: number;
}

const clumps: Clump[] = [];
for (let i = 0; i < 11; i++) {
  /* Marched along the band with an overlap rather than dropped at random, so
     there is no gap where the band simply stops. */
  const t0 = -0.08 + i * 0.1;
  const t1 = t0 + 0.16 + rand() * 0.2;
  const side = i % 2 === 0 ? 1 : -1;
  const off = side * (3.2 + rand() * 5);
  const x1 = r1(t0 * 100);
  const x2 = r1(t1 * 100);
  clumps.push({
    x1,
    y1: r1(wayY(x1) + off),
    x2,
    y2: r1(wayY(x2) + off),
    width: r1(3 + rand() * 5),
    opacity: r3(0.08 + rand() * 0.1),
  });
}

const cls = (s: Star) =>
  `mg-star mg-star--${s.clock}${s.mag ? ` mg-star--${s.mag}` : ""}`;
---

<div class="mg-starfield" aria-hidden="true">
  <svg class="mg-starfield__svg" role="presentation" focusable="false">
    <defs>
      {/* The glow fades out ALONG the band as well as across it, so the arm
          thins away toward the horizon instead of ending at the frame edge.
          Across the band is handled by the blur in scene.css. */}
      <linearGradient class="mg-way-fade" id="mg-way-fade" x1="0" y1="1" x2="1" y2="0">
        <stop offset="0" stop-opacity="0" />
        <stop offset="0.3" stop-opacity="0.75" />
        <stop offset="0.72" stop-opacity="1" />
        <stop offset="1" stop-opacity="0.35" />
      </linearGradient>
    </defs>

    {/* -------------------------------------------------------------- night */}
    <g class="mg-sky mg-sky--night">
      {/* The Milky Way: a broad faint halo down the whole diagonal, with the
          clumps generated above riding on it. Widths are percentages, so the
          band keeps its weight against the hero at any size, and scene.css
          blurs the group — which is what turns a run of hard-edged strokes into
          cloud. */}
      <g class="mg-way">
        <line class="mg-way__halo" x1="0%" y1={`${WAY_LEFT}%`} x2="100%" y2={`${WAY_RIGHT}%`} />
        {
          clumps.map((c) => (
            <line
              class="mg-way__clump"
              x1={`${c.x1}%`}
              y1={`${c.y1}%`}
              x2={`${c.x2}%`}
              y2={`${c.y2}%`}
              style={{ strokeWidth: `${c.width}%`, opacity: c.opacity }}
            />
          ))
        }
      </g>

      {/* The galactic stars first: they are the fainter population, and drawing
          them under the general field keeps a bright foreground star on top
          where it crosses the band. */}
      <g class="mg-starfield__way">
        {way.map((s) => <circle class={cls(s)} cx={`${s.x}%`} cy={`${s.y}%`} r={s.r} />)}
      </g>

      <g class="mg-starfield__field">
        {stars.map((s) => <circle class={cls(s)} cx={`${s.x}%`} cy={`${s.y}%`} r={s.r} />)}
      </g>
    </g>
  </svg>

  <Celestial />
</div>
