---
/**
 * One side of the climber — an arm chain and a leg chain, seen head-on.
 *
 * Authored once and mirrored for the far side; the two sides differ only by the
 * pose angles in scene.css, because nobody climbs symmetrically.
 */
---

<g class="mg-cl-leg">
  <path class="mg-limb" d="M 2.2 -13 L 5.2 -7.4" />
  <g class="mg-cl-leg__shin">
    <path class="mg-limb" d="M 5.2 -7.4 L 5.6 -1.6" />
    <path class="mg-limb" d="M 5.6 -1.6 L 7.4 -1.1" />
  </g>
</g>
<g class="mg-cl-arm">
  <path class="mg-limb" d="M 3.2 -21.4 L 7 -24.8" />
  <g class="mg-cl-arm__fore"><path class="mg-limb" d="M 7 -24.8 L 9.6 -29.4" /></g>
</g>
