---
/**
 * The tee shot: figure, tee, ball, and the green it is played to.
 *
 * Figure and target share one scale, so the carry stays in the figure's own
 * units and the hole sits at a plausible distance rather than a drawn one. Both
 * compositions place this identically relative to the golfer, so it is one
 * component rather than the same six shapes written out twice.
 */
import Golfer from "./Golfer.astro";
---

<Golfer />
<path class="mg-thread mg-tee" d="M 15.2 -0.3 L 15.2 -2.3" />
<circle class="mg-ball" cx="15.2" cy="-3.1" r="0.85" />
<ellipse class="mg-cup" cx="68" cy="-1.4" rx="2.2" ry="0.9" />
<path class="mg-thread mg-flagstick" d="M 68 -1.4 L 68 -19" />
<path class="mg-flag" d="M 68 -19 C 72 -18.4, 74 -16.6, 77.5 -15.8 L 68 -12.6 Z" />
