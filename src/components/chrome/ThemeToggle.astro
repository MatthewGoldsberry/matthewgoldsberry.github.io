---
/**
 * Scheme toggle.
 *
 * Deliberately not a React island. It is one event listener over one attribute,
 * and hydrating a component to own that would cost more than the whole rest of
 * the page's JavaScript. Astro bundles the module script below and it runs once.
 *
 * The palette itself follows `color-scheme` through `light-dark()` (see
 * global.css), so this writes one attribute and the entire site — including the
 * SVG landscape — repaints. There is no class list to keep in sync.
 */
---

<button
  type="button"
  id="theme-toggle"
  class="inline-flex size-8 items-center justify-center rounded-full border border-edge-strong text-ink-muted transition-colors duration-150 ease-mg hover:border-accent hover:text-accent-text"
  aria-label="Switch colour scheme"
>
  {/* Both glyphs ship; the stylesheet shows whichever scheme you would switch
      TO, which is the one that is not currently in effect. */}
  <svg
    class="tt-sun size-4"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4" />
    <path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    />
  </svg>

  <svg
    class="tt-moon size-4"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
  </svg>
</button>

<style>
  /* Three states, not two: the reader may have chosen light, chosen dark, or
     chosen nothing — and "nothing" is the default, where only the system
     preference says which scheme is on screen. A rule set keyed solely on
     [data-theme] would show the wrong glyph for every visitor who never touched
     the button, which is most of them. */

  /* Default: no choice recorded, system is light. */
  .tt-sun { display: none; }
  .tt-moon { display: block; }

  /* Default: no choice recorded, system is dark. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .tt-sun { display: block; }
    :root:not([data-theme="light"]) .tt-moon { display: none; }
  }

  /* An explicit choice wins over both of the above, in either direction. */
  :root[data-theme="dark"] .tt-sun { display: block; }
  :root[data-theme="dark"] .tt-moon { display: none; }
  :root[data-theme="light"] .tt-sun { display: none; }
  :root[data-theme="light"] .tt-moon { display: block; }
</style>

<script>
  const root = document.documentElement;
  const button = document.getElementById("theme-toggle");

  /** What is actually on screen right now, whether chosen or inherited. */
  const current = (): "light" | "dark" =>
    (root.dataset.theme as "light" | "dark" | undefined) ??
    (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");

  button?.addEventListener("click", () => {
    const next = current() === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {
      /* Storage unavailable. The choice still applies for this page view. */
    }
  });
</script>
